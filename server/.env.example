# 复制为 server/.env 并填写（.env 已 gitignore，不会入库）；
# 生产环境建议改用 systemd 的 EnvironmentFile。

# 管理后台口令（必填，否则 /admin/ 无法登录）
GARDEN_ADMIN_PASSWORD=change-me

# 数据目录（SQLite 与上传图片），默认 server/data
# GARDEN_DATA_DIR=/var/lib/shadow-garden

# 会话有效期（小时），默认 72
# GARDEN_SESSION_TTL_HOURS=72

# 上传大小限制（MB），默认 8
# GARDEN_MAX_UPLOAD_MB=8
