# 复制为 server/.env 并填写（.env 已 gitignore，不会入库）；
# 生产环境建议改用 systemd 的 EnvironmentFile（见 deploy/shadow-garden.service.example）。

# 规范入口与 Shadow Identity OIDC（管理后台必填）
GARDEN_CANONICAL_URL=https://garden.example.com
GARDEN_OIDC_ISSUER=https://auth.example.com
GARDEN_OIDC_CLIENT_ID=shadow-garden
GARDEN_OIDC_CLIENT_SECRET_FILE=/run/secrets/shadow-garden-oidc-client-secret
GARDEN_OIDC_REDIRECT_URI=https://garden.example.com/auth/callback
GARDEN_OIDC_POST_LOGOUT_REDIRECT_URI=https://garden.example.com/
GARDEN_OIDC_REQUIRED_GROUP=garden-admins
GARDEN_OIDC_SESSION_DB=/var/lib/shadow-garden/web_auth.db
# GARDEN_OIDC_SESSION_TTL_SECONDS=43200

# 内容 Agent 使用独立机器凭据，不复用浏览器 OIDC 会话
GARDEN_AGENT_TOKEN=change-to-a-long-random-token

# 数据库：留空用本地 SQLite（server/data/garden.db）；生产填 PostgreSQL 连接串
# GARDEN_DB_URL=postgresql://shadow_garden:密码@127.0.0.1:5432/shadow_garden

# Redis：用于浇水防刷等轻量状态
# GARDEN_REDIS_URL=redis://127.0.0.1:6379/0

# 数据目录（SQLite 与上传图片），默认 server/data
# GARDEN_DATA_DIR=/var/lib/shadow-garden

# 上传大小限制（MB），默认 8
# GARDEN_MAX_UPLOAD_MB=8
