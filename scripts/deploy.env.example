# 复制为 deploy.env 并填写真实值（deploy.env 已 gitignore，不会入库）

# —— 必填：静态站 ——
DEPLOY_REMOTE="your-ssh-host-alias"
DEPLOY_WEBROOT="/var/www/your-site"

# —— 可选：后端（留空则只部署静态站）——
# 服务器上后端代码目录；首次部署后需在服务器配置 systemd（见 deploy/ 目录示例）
#DEPLOY_SERVER_DIR="/opt/shadow-garden/server"
# systemd 服务名，配置后每次部署自动重启
#DEPLOY_SERVICE="shadow-garden"

# —— 可选：部署后验证 ——
DEPLOY_VERIFY_URL="http://your-server/"
