# Shadow Garden 后端 systemd 服务示例
# 用法（服务器上）：
#   sudo cp shadow-garden.service.example /etc/systemd/system/shadow-garden.service
#   sudo mkdir -p /var/lib/shadow-garden/uploads && sudo chown -R www-data:www-data /var/lib/shadow-garden
#   sudo install -m 600 /dev/null /etc/shadow-garden.env   # 按下面注释填入环境变量
#   sudo systemctl daemon-reload && sudo systemctl enable --now shadow-garden
[Unit]
Description=Shadow Garden API (FastAPI + PostgreSQL + Redis)
After=network.target postgresql.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/shadow-garden/server
# /etc/shadow-garden.env 内容示例：
#   GARDEN_AGENT_TOKEN=供内容 Agent 使用的独立随机令牌
#   GARDEN_CANONICAL_URL=https://garden.example.com
#   GARDEN_OIDC_ISSUER=https://auth.example.com
#   GARDEN_OIDC_CLIENT_ID=shadow-garden
#   GARDEN_OIDC_CLIENT_SECRET_FILE=/etc/shadow-garden/oidc-client-secret
#   GARDEN_OIDC_REDIRECT_URI=https://garden.example.com/auth/callback
#   GARDEN_OIDC_POST_LOGOUT_REDIRECT_URI=https://garden.example.com/
#   GARDEN_OIDC_REQUIRED_GROUP=garden-admins
#   GARDEN_OIDC_SESSION_DB=/var/lib/shadow-garden/web_auth.db
#   GARDEN_DB_URL=postgresql://shadow_garden:数据库密码@127.0.0.1:5432/shadow_garden
#   GARDEN_REDIS_URL=redis://127.0.0.1:6379/0
#   GARDEN_DATA_DIR=/var/lib/shadow-garden
#   GARDEN_ASSET_MODE=platform
#   GARDEN_ASSET_BASE_URL=https://media.example.com
#   GARDEN_ASSET_SERVICE_TOKEN_FILE=/etc/shadow-garden/platform-service-token
#   GARDEN_ASSET_OWNER_ID=替换为稳定的 Shadow 用户 UUID
EnvironmentFile=/etc/shadow-garden.env
ExecStart=/opt/shadow-garden/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8300
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
